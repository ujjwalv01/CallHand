# Copy this file to .env and fill in real values. .env is git-ignored.
# Both workspaces read from this single root file.

# ---------- Server ----------
PORT=4000
NODE_ENV=development
# Public URL that Vapi and Twilio will call back to. In dev this is your ngrok URL.
PUBLIC_BASE_URL=https://your-subdomain.ngrok-free.app
# Where the React dashboard runs; used for CORS.
CLIENT_ORIGIN=http://localhost:5173

# ---------- Database (Neon) ----------
DATABASE_URL=postgres://user:password@ep-xxx.aws.neon.tech/neondb?sslmode=require

# ---------- Auth ----------
# Any long random string. Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# ---------- Vapi (voice agent) ----------
VAPI_API_KEY=
# Filled in after running: npm run setup-vapi
VAPI_ASSISTANT_ID=
# Vapi signs webhooks with this; you choose the value and paste the same one in the Vapi dashboard.
VAPI_WEBHOOK_SECRET=

# ---------- LLM behind the agent (free tier for dev) ----------
GROQ_API_KEY=

# ---------- Twilio (phone numbers + SMS) — optional until day 7 ----------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
